# pnpm keeps each package's node_modules isolated by default, which is usually
# right, but TypeScript's automatic @types/* resolution needs to see them from
# any package in the workspace. This hoists just @types/* to the root so a
# single @types/node in the root package.json covers every package, instead of
# needing to be declared over and over.
public-hoist-pattern[]=@types/*
