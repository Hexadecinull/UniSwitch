{
  "name": "@uniswitch/web",
  "version": "0.1.0",
  "private": true,
  "description": "UniSwitch web app and API server",
  "type": "module",
  "dependencies": {
    "@uniswitch/core": "workspace:*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/public dist/public",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
